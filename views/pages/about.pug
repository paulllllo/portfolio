extends ../base.pug

block variables
    - var template = 'about'

block content
    .about

        .about_wrapper
            .about_main
                .about_main_content
                    .about_main_content_media
                        img.about_main_content_media_image(alt=profile.data.profile_picture.alt, src=profile.data.profile_picture.url)

                    h2.about_main_content_name(data-animation="textSlide")="Odigbo Kelechi Paul"
                    
                    p.about_main_content_bio(data-animation="textSlide")=about.data.intro

                .about_main_button
                    span="Walk with me"

                    svg.about_main_button_icon(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512")
                        path(d="M169.4 470.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 370.8 224 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 306.7L54.6 265.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z")

            .about_roadmap
                .about_roadmap_steps

                each info in about.data.body
                    .about_roadmap_info(class=`${info.primary.position === 'right' ? 'right' : 'left'}`)
                        .about_roadmap_info_wrapper
                            .about_roadmap_badge

                            p.about_roadmap_info_text=info.primary.fact
        

        include ./../shared/footer
